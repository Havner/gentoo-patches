 /*
+ * SendSPDInfoFrame() - Send a Source Product Description InfoFrame naming the
+ * source "NVIDIA" / "GeForce", source type "PC general", as the Windows driver
+ * does.  Some sinks key behaviour off it: LG TVs use it to classify the input
+ * (PC mode, G-SYNC vs plain VRR).
+ *
+ * Ada only (NVC770_DISPLAY): Ada drives HDMI through the NVC6 HAL, which uses
+ * just the legacy AVI/VSI/generic packet slots, leaving the six per-head
+ * "shared generic" infoframe slots of the C771 SOR class unused.  A slot is
+ * acquired from RM once per head and kept; if RM refuses, the last slot is
+ * used.  The packet is laid out as the C771 shared generic registers expect:
+ * HB0-HB3, then PB0 (checksum) and the 25 payload bytes.
+ */
+#define SPD_SHARED_GENERIC_SLOTS          6
+#define SPD_SHARED_GENERIC_FALLBACK_SLOT  (SPD_SHARED_GENERIC_SLOTS - 1)
+
+static void SendSPDInfoFrame(const NVDispEvoRec *pDispEvo, const NvU32 head)
+{
+    /* The slot cache lives in the disp; everything else here is read-only. */
+    NVDispEvoRec *pDispEvoMutable = (NVDispEvoRec *)pDispEvo;
+    const NVDispHeadStateEvoRec *pHeadState = &pDispEvo->headState[head];
+    NVDevEvoPtr pDevEvo = pDispEvo->pDevEvo;
+    static const char vendor[] = "NVIDIA";
+    static const char product[] = "GeForce";
+    NvU8 packet[4 /* HB0-HB3 */ + 1 /* PB0 */ +
+                sizeof(NVT_SPD_INFOFRAME_PAYLOAD)] = { 0 };
+    NvU8 *pPayload = &packet[5];
+    NVHDMIPKT_RESULT ret;
+    NvU8 checksum = 0;
+    NvU32 slot, i;
+
+    if (pDevEvo->dispClass != NVC770_DISPLAY ||
+        head >= NVKMS_MAX_HEADS_PER_DISP) {
+        return;
+    }
+
+    if (pDispEvo->spdInfoFrameSlot[head] == 0) {
+        NV0073_CTRL_SPECIFIC_ACQUIRE_SHARED_GENERIC_PACKET_PARAMS params = { 0 };
+        NvU32 status;
+
+        params.subDeviceInstance = pDispEvo->displayOwner;
+        params.targetHeadIndex = head;
+
+        status = nvRmApiControl(nvEvoGlobal.clientHandle,
+                                pDevEvo->displayCommonHandle,
+                                NV0073_CTRL_CMD_SPECIFIC_ACQUIRE_SHARED_GENERIC_PACKET,
+                                &params,
+                                sizeof(params));
+
+        if (status == NVOS_STATUS_SUCCESS &&
+            params.infoframeIndex < SPD_SHARED_GENERIC_SLOTS) {
+            slot = params.infoframeIndex;
+            nvEvoLogDisp(pDispEvo, EVO_LOG_INFO,
+                         "HDMI SPD infoframe: head %u, shared generic slot %u",
+                         head, slot);
+        } else {
+            slot = SPD_SHARED_GENERIC_FALLBACK_SLOT;
+            nvEvoLogDisp(pDispEvo, EVO_LOG_WARN,
+                         "HDMI SPD infoframe: slot acquire failed (status 0x%x), "
+                         "head %u, using shared generic slot %u",
+                         status, head, slot);
+        }
+        pDispEvoMutable->spdInfoFrameSlot[head] = slot + 1;
+    }
+    slot = pDispEvo->spdInfoFrameSlot[head] - 1;
+
+    packet[0] = hdmi_pktType_SrcProdDescInfoFrame;    /* HB0: 0x83 */
+    packet[1] = 1;                                    /* HB1: version */
+    packet[2] = sizeof(NVT_SPD_INFOFRAME_PAYLOAD);    /* HB2: length, 25 */
+    packet[3] = 0;                                    /* HB3: reserved */
+
+    /* PB1-PB8 vendor, PB9-PB24 product: 7-bit ASCII, zero padded */
+    nvkms_memcpy(&pPayload[0], vendor, sizeof(vendor) - 1);
+    nvkms_memcpy(&pPayload[8], product, sizeof(product) - 1);
+    pPayload[24] = 0x09;                              /* PB25: PC general */
+
+    /* PB0: all header and payload bytes must sum to zero */
+    for (i = 0; i < sizeof(packet); i++) {
+        checksum += packet[i];
+    }
+    packet[4] = ~checksum + 1;
+
+    ret = NvHdmiPkt_PacketWrite(pDevEvo->hdmiLib.handle,
+                                pDispEvo->displayOwner,
+                                pHeadState->activeRmId,
+                                head,
+                                NVHDMIPKT_TYPE_SHARED_GENERIC1 + slot,
+                                NVHDMIPKT_TRANSMIT_CONTROL_ENABLE_EVERY_FRAME_SW_CHECKSUM,
+                                sizeof(packet),
+                                packet);
+
+    if (ret != NVHDMIPKT_SUCCESS) {
+        nvEvoLogDispDebug(pDispEvo, EVO_LOG_ERROR,
+                          "Error in sending SPD InfoFrame: %d", ret);
+    }
+}
