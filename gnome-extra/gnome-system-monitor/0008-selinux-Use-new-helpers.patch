From cf30a3cd45b7fa42bdefa9d579933ecd8de3fe61 Mon Sep 17 00:00:00 2001
From: Zander Brown <zbrown@gnome.org>
Date: Wed, 16 Sep 2026 02:54:21 +0100
Subject: [PATCH 08/11] selinux: Use new helpers

---
 src/selinux/gsm-selinux.c | 74 +++++++--------------------------------
 src/selinux/meson.build   |  2 +-
 2 files changed, 13 insertions(+), 63 deletions(-)

diff --git a/src/selinux/gsm-selinux.c b/src/selinux/gsm-selinux.c
index b98b8805..4e1957fc 100644
--- a/src/selinux/gsm-selinux.c
+++ b/src/selinux/gsm-selinux.c
@@ -6,6 +6,8 @@
 
 #include <glib.h>
 
+#include "gsm-module-loader.h"
+
 #include "gsm-selinux.h"
 
 
@@ -14,78 +16,26 @@ static void (*freecon) (char *);
 static int (*is_selinux_enabled) (void);
 
 
-static inline GModule *
-load_selinux_module (void)
-{
-  g_autoptr (GError) error = NULL;
-  GModule *module =
-    g_module_open_full ("libselinux.so.1",
-                        G_MODULE_BIND_LAZY | G_MODULE_BIND_LOCAL,
-                        &error);
-
-  if (error) {
-    g_debug ("Could not load libselinux.so.1: %s", error->message);
-    goto fail;
-  }
-
-  if (!module) {
-    g_debug ("Could not load libselinux.so.1");
-    goto fail;
-  }
-
-  if (!g_module_symbol (module, "getpidcon", (gpointer *) &getpidcon)) {
-    g_debug ("Could not load getpidcon from libselinux.so.1");
-    goto fail;
-  } else {
-    g_debug ("Loaded getpidcon from libselinux.so.1");
-  }
+GSM_DEFINE_MODULE_LOADER (gsm, selinux, "libselinux.so.1")
 
-  if (!g_module_symbol (module, "freecon", (gpointer *) &freecon)) {
-    g_debug ("Could not load freecon from libselinux.so.1");
-    goto fail;
-  } else {
-    g_debug ("Loaded freecon from libselinux.so.1");
-  }
-  
-  if (!g_module_symbol (module,
-                        "is_selinux_enabled",
-                        (gpointer *) &is_selinux_enabled)) {
-    g_debug ("Could not load is_selinux_enabled from libselinux.so.1");
-    goto fail;
-  } else {
-    g_debug ("Loaded is_selinux_enabled from libselinux.so.1");
-  }
 
-  g_module_make_resident (module);
-
-  return g_steal_pointer (&module);
-
-fail:
-  g_clear_pointer (&module, g_module_close);
-
-  return NULL;
-}
-
-
-static inline GModule *
-get_selinux_module (void)
+static inline GsmModuleInitResult
+gsm_selinux_init_module (GModule *module)
 {
-  static GModule *module = NULL;
-
-  if (g_once_init_enter_pointer (&module)) {
-    GModule *gksu = load_selinux_module ();
+  GSM_MODULE_REQUIRE_SYMBOL (module, "libselinux.so.1", getpidcon);
+  GSM_MODULE_REQUIRE_SYMBOL (module, "libselinux.so.1", freecon);
+  GSM_MODULE_REQUIRE_SYMBOL (module, "libselinux.so.1", is_selinux_enabled);
 
-    g_once_init_leave_pointer (&module, g_steal_pointer (&gksu));
-  }
+  g_module_make_resident (module);
 
-  return module;
+  return GSM_MODULE_INIT_SUCCESS;
 }
 
 
 gboolean
 gsm_selinux_is_enabled (void)
 {
-  if (get_selinux_module () == NULL) {
+  if (!gsm_selinux_get_or_load_module ()) {
     return FALSE;
   }
 
@@ -111,7 +61,7 @@ gsm_selinux_get_context (pid_t pid)
   g_autofree char *result = NULL;
   char *con = NULL;
 
-  if (get_selinux_module () == NULL) {
+  if (!gsm_selinux_get_or_load_module ()) {
     goto out;
   }
 
diff --git a/src/selinux/meson.build b/src/selinux/meson.build
index 6966db93..e6bb219e 100644
--- a/src/selinux/meson.build
+++ b/src/selinux/meson.build
@@ -4,7 +4,7 @@ libgsm_selinux_sources = [
   'gsm-selinux.h',
 ]
 
-libgsm_selinux_dependencies = [glib, gmodule]
+libgsm_selinux_dependencies = [glib, gmodule, libgsm_utils_dep]
 
 libgsm_selinux = static_library(
   'gsm-selinux',
-- 
2.55.0

