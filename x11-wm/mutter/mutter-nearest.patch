+++ b/data/org.gnome.mutter.gschema.xml.in
@@ -102,6 +102,17 @@
       </description>
     </key>
 
+    <key name="nearest-scaling-for-legacy" type="b">
+      <default>false</default>
+      <summary>Use nearest scaling for legacy applications</summary>
+      <description>
+        If enabled, windows that cannot scale themselves to the Wayland
+        desktop scale are magnified using nearest-neighbor interpolation
+        instead of linear interpolation. This keeps such scaled content
+        sharp at the cost of a more pixelated appearance.
+      </description>
+    </key>
+
     <key name="experimental-features"
         flags='org.gnome.mutter.MetaExperimentalFeature'>
       <default>[]</default>
