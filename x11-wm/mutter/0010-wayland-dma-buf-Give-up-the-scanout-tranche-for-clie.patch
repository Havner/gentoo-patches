diff --git a/src/wayland/meta-wayland-dma-buf.c b/src/wayland/meta-wayland-dma-buf.c
index c0f05a14ea..3caf0f9ac5 100644
--- a/src/wayland/meta-wayland-dma-buf.c
+++ b/src/wayland/meta-wayland-dma-buf.c
@@ -638,6 +638,42 @@ crtc_supports_modifier (MetaCrtcKms *crtc_kms,
   return has_modifier (crtc_modifiers, drm_modifier);
 }
 
+/* Whether the buffer's format/modifier could be put on the view's primary
+ * plane. Non-dma-buf buffers and non-KMS views report TRUE: this is only meant
+ * to recognize "wrong format/modifier" scanout failures. */
+gboolean
+meta_wayland_dma_buf_is_plane_compatible (MetaWaylandBuffer *buffer,
+                                          ClutterStageView  *stage_view)
+{
+  MetaWaylandDmaBufBuffer *dma_buf;
+  const MetaFormatInfo *format_info;
+  MetaCrtc *crtc;
+  MetaCrtcKms *crtc_kms;
+
+  dma_buf = meta_wayland_dma_buf_from_buffer (buffer);
+  if (!dma_buf)
+    return TRUE;
+
+  crtc = meta_renderer_view_get_crtc (META_RENDERER_VIEW (stage_view));
+  if (!META_IS_CRTC_KMS (crtc))
+    return TRUE;
+  crtc_kms = META_CRTC_KMS (crtc);
+
+  format_info = meta_format_info_from_drm_format (dma_buf->drm_format);
+  if (!format_info)
+    return TRUE;
+
+  if (format_info->opaque_substitute != DRM_FORMAT_INVALID &&
+      crtc_supports_modifier (crtc_kms,
+                              format_info->opaque_substitute,
+                              dma_buf->drm_modifier))
+    return TRUE;
+
+  return crtc_supports_modifier (crtc_kms,
+                                 dma_buf->drm_format,
+                                 dma_buf->drm_modifier);
+}
+
 CoglScanout *
 meta_wayland_dma_buf_try_acquire_scanout (MetaWaylandBuffer     *buffer,
                                           CoglOnscreen          *onscreen,
@@ -1348,7 +1384,8 @@ find_scanout_tranche_func (gconstpointer a,
     return -1;
 }
 
-static void
+/* Returns TRUE if the feedback's tranches changed */
+static gboolean
 ensure_scanout_tranche (MetaWaylandDmaBufSurfaceFeedback *surface_feedback,
                         MetaCrtc                         *crtc)
 {
@@ -1365,13 +1402,14 @@ ensure_scanout_tranche (MetaWaylandDmaBufSurfaceFeedback *surface_feedback,
   g_autoptr (GArray) formats = NULL;
   MetaWaylandDmaBufTranchePriority priority;
   MetaWaylandDmaBufTrancheFlags flags;
+  gboolean removed_old = FALSE;
 
-  g_return_if_fail (META_IS_CRTC_KMS (crtc));
+  g_return_val_if_fail (META_IS_CRTC_KMS (crtc), FALSE);
 
   crtc_kms = META_CRTC_KMS (crtc);
   kms_plane = meta_crtc_kms_get_assigned_primary_plane (crtc_kms);
 
-  g_return_if_fail (META_IS_KMS_PLANE (kms_plane));
+  g_return_val_if_fail (META_IS_KMS_PLANE (kms_plane), FALSE);
 
   el = g_list_find_custom (feedback->tranches, NULL, find_scanout_tranche_func);
   if (el)
@@ -1379,10 +1417,11 @@ ensure_scanout_tranche (MetaWaylandDmaBufSurfaceFeedback *surface_feedback,
       tranche = el->data;
 
       if (tranche->scanout_crtc_id == meta_crtc_get_id (crtc))
-        return;
+        return FALSE;
 
       meta_wayland_dma_buf_tranche_free (tranche);
       feedback->tranches = g_list_delete_link (feedback->tranches, el);
+      removed_old = TRUE;
     }
 
   formats = g_array_new (FALSE, FALSE, sizeof (MetaWaylandDmaBufFormat));
@@ -1418,7 +1457,7 @@ ensure_scanout_tranche (MetaWaylandDmaBufSurfaceFeedback *surface_feedback,
         }
 
       if (formats->len == 0)
-        return;
+        return removed_old;
     }
   else
     {
@@ -1439,7 +1478,7 @@ ensure_scanout_tranche (MetaWaylandDmaBufSurfaceFeedback *surface_feedback,
         }
 
       if (formats->len == 0)
-        return;
+        return removed_old;
     }
 
   priority = META_WAYLAND_DMA_BUF_TRANCHE_PRIORITY_HIGH;
@@ -1450,9 +1489,11 @@ ensure_scanout_tranche (MetaWaylandDmaBufSurfaceFeedback *surface_feedback,
                                               flags);
   tranche->scanout_crtc_id = meta_crtc_get_id (crtc);
   meta_wayland_dma_buf_feedback_add_tranche (feedback, tranche);
+  return TRUE;
 }
 
-static void
+/* Returns TRUE if the feedback's tranches changed */
+static gboolean
 clear_scanout_tranche (MetaWaylandDmaBufSurfaceFeedback *surface_feedback)
 {
   MetaWaylandDmaBufFeedback *feedback = surface_feedback->feedback;
@@ -1461,23 +1502,26 @@ clear_scanout_tranche (MetaWaylandDmaBufSurfaceFeedback *surface_feedback)
 
   el = g_list_find_custom (feedback->tranches, NULL, find_scanout_tranche_func);
   if (!el)
-    return;
+    return FALSE;
 
   tranche = el->data;
   meta_wayland_dma_buf_tranche_free (tranche);
   feedback->tranches = g_list_delete_link (feedback->tranches, el);
+  return TRUE;
 }
 
-static void
+/* Returns TRUE if the feedback's tranches changed */
+static gboolean
 update_surface_feedback_tranches (MetaWaylandDmaBufSurfaceFeedback *surface_feedback)
 {
   MetaCrtc *crtc;
 
   crtc = meta_wayland_surface_get_scanout_candidate (surface_feedback->surface);
-  if (crtc)
-    ensure_scanout_tranche (surface_feedback, crtc);
+  if (crtc &&
+      !meta_wayland_surface_is_scanout_tranche_disabled (surface_feedback->surface))
+    return ensure_scanout_tranche (surface_feedback, crtc);
   else
-    clear_scanout_tranche (surface_feedback);
+    return clear_scanout_tranche (surface_feedback);
 }
 
 static void
@@ -1487,7 +1531,12 @@ on_scanout_candidate_changed (MetaWaylandSurface               *surface,
 {
   GList *l;
 
-  update_surface_feedback_tranches (surface_feedback);
+  /* Only re-send when the tranches changed. The scanout candidate can flip on
+   * every buffer detach/attach (e.g. Wine during swapchain recreation), and
+   * some clients (NVIDIA's Vulkan WSI) treat any feedback event as a reason to
+   * mark the swapchain out of date, which then flips the candidate again. */
+  if (!update_surface_feedback_tranches (surface_feedback))
+    return;
 
   for (l = surface_feedback->resources; l; l = l->next)
     {
diff --git a/src/wayland/meta-wayland-dma-buf.h b/src/wayland/meta-wayland-dma-buf.h
index 729c0a516f..36c98a9e52 100644
--- a/src/wayland/meta-wayland-dma-buf.h
+++ b/src/wayland/meta-wayland-dma-buf.h
@@ -70,6 +70,10 @@ meta_wayland_drm_syncobj_create_source (MetaWaylandBuffer                *buffer
                                         MetaWaylandDmaBufSourceDispatch   dispatch,
                                         gpointer                          user_data);
 
+gboolean
+meta_wayland_dma_buf_is_plane_compatible (MetaWaylandBuffer *buffer,
+                                          ClutterStageView  *stage_view);
+
 CoglScanout *
 meta_wayland_dma_buf_try_acquire_scanout (MetaWaylandBuffer     *buffer,
                                           CoglOnscreen          *onscreen,
diff --git a/src/wayland/meta-wayland-surface-private.h b/src/wayland/meta-wayland-surface-private.h
index e08cca7f07..ecc138487e 100644
--- a/src/wayland/meta-wayland-surface-private.h
+++ b/src/wayland/meta-wayland-surface-private.h
@@ -292,6 +292,11 @@ struct _MetaWaylandSurface
 
   /* dma-buf feedback */
   MetaCrtc *scanout_candidate;
+  /* When the scanout tranche was first offered since the last successful
+   * scanout (0: not offered), and whether it has been given up on because the
+   * client kept committing buffers the primary plane can't scan out. */
+  int64_t scanout_tranche_offered_us;
+  gboolean scanout_tranche_disabled;
 
   /* Transactions */
   struct {
@@ -435,6 +440,11 @@ MetaCrtc * meta_wayland_surface_get_scanout_candidate (MetaWaylandSurface *surfa
 void meta_wayland_surface_set_scanout_candidate (MetaWaylandSurface *surface,
                                                  MetaCrtc           *crtc);
 
+gboolean meta_wayland_surface_is_scanout_tranche_disabled (MetaWaylandSurface *surface);
+
+gboolean meta_wayland_surface_scanout_given_up (MetaWaylandSurface *surface,
+                                               ClutterStageView   *stage_view);
+
 int meta_wayland_surface_get_geometry_scale (MetaWaylandSurface *surface);
 
 META_EXPORT_TEST
diff --git a/src/wayland/meta-wayland-surface.c b/src/wayland/meta-wayland-surface.c
index 9e58f2a22d..bb8fcdca47 100644
--- a/src/wayland/meta-wayland-surface.c
+++ b/src/wayland/meta-wayland-surface.c
@@ -2638,11 +2638,75 @@ meta_wayland_surface_get_buffer_height (MetaWaylandSurface *surface)
     return 0;
 }
 
+/* How long a client gets, after it was first offered the scanout tranche, to
+ * switch to buffers the primary plane can scan out. Well-behaved clients
+ * reallocate within a few frames (Vulkan WSI: next acquire returns
+ * VK_ERROR_OUT_OF_DATE_KHR). */
+#define SCANOUT_TRANCHE_GRACE_US (G_USEC_PER_SEC)
+
+/*
+ * Stop offering the scanout tranche to a surface that keeps committing buffers
+ * the primary plane can't scan out long after it was offered.
+ *
+ * Re-offering is useless at that point, and some clients react badly to it: e.g.
+ * Indiana Jones and the Great Circle on NVIDIA via Wine stalls its GPU work for
+ * 2 s whenever the tranche arrives, recreates its swapchain, gets a compressed
+ * modifier again, and loops (~0.5 fps). Without the tranche it's composited at
+ * full rate. Only format/modifier failures count; the surface keeps being a
+ * scanout and fullscreen (VRR) candidate.
+ */
+static void
+maybe_disable_scanout_tranche (MetaWaylandSurface *surface,
+                               ClutterStageView   *stage_view)
+{
+  int64_t elapsed_us;
+
+  if (surface->scanout_tranche_disabled ||
+      !surface->scanout_tranche_offered_us ||
+      !surface->buffer)
+    return;
+
+  if (meta_wayland_dma_buf_is_plane_compatible (surface->buffer, stage_view))
+    return;
+
+  elapsed_us = g_get_monotonic_time () - surface->scanout_tranche_offered_us;
+  if (elapsed_us < SCANOUT_TRANCHE_GRACE_US)
+    return;
+
+  meta_topic (META_DEBUG_RENDER,
+              "Client still commits buffers the primary plane can't scan out "
+              "%.1f s after the scanout tranche was offered, not offering it "
+              "anymore", elapsed_us / (double) G_USEC_PER_SEC);
+  surface->scanout_tranche_disabled = TRUE;
+  /* Re-send the surface's dma-buf feedback without the scanout tranche */
+  g_object_notify_by_pspec (G_OBJECT (surface),
+                            obj_props[PROP_SCANOUT_CANDIDATE]);
+}
+
+gboolean
+meta_wayland_surface_is_scanout_tranche_disabled (MetaWaylandSurface *surface)
+{
+  return surface->scanout_tranche_disabled;
+}
+
+/* Once the scanout tranche was given up, don't keep attempting scanout on
+ * every frame with buffers the primary plane can't take. A buffer that happens
+ * to be scanout-capable is still tried. */
+gboolean
+meta_wayland_surface_scanout_given_up (MetaWaylandSurface *surface,
+                                       ClutterStageView   *stage_view)
+{
+  return surface->scanout_tranche_disabled &&
+         surface->buffer &&
+         !meta_wayland_dma_buf_is_plane_compatible (surface->buffer, stage_view);
+}
+
 CoglScanout *
 meta_wayland_surface_try_acquire_scanout (MetaWaylandSurface *surface,
                                           CoglOnscreen       *onscreen,
                                           ClutterStageView   *stage_view)
 {
+  CoglScanout *scanout;
   MetaSurfaceActor *surface_actor;
   MtkMonitorTransform view_transform;
   ClutterActorBox actor_box;
@@ -2750,11 +2814,17 @@ meta_wayland_surface_try_acquire_scanout (MetaWaylandSurface *surface,
     }
 #endif
 
-  return meta_wayland_buffer_try_acquire_scanout (surface->buffer,
-                                                  onscreen,
-                                                  stage_view,
-                                                  src_rect_ptr,
-                                                  &crtc_dst_rect);
+  scanout = meta_wayland_buffer_try_acquire_scanout (surface->buffer,
+                                                     onscreen,
+                                                     stage_view,
+                                                     src_rect_ptr,
+                                                     &crtc_dst_rect);
+  if (scanout)
+    surface->scanout_tranche_offered_us = 0;
+  else
+    maybe_disable_scanout_tranche (surface, stage_view);
+
+  return scanout;
 }
 
 MetaCrtc *
@@ -2771,6 +2841,8 @@ meta_wayland_surface_set_scanout_candidate (MetaWaylandSurface *surface,
     return;
 
   g_set_object (&surface->scanout_candidate, crtc);
+  if (crtc && !surface->scanout_tranche_offered_us)
+    surface->scanout_tranche_offered_us = g_get_monotonic_time ();
   g_object_notify_by_pspec (G_OBJECT (surface),
                             obj_props[PROP_SCANOUT_CANDIDATE]);
 }
